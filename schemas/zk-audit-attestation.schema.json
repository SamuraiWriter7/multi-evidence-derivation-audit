{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/meda/v0.2/zk-audit-attestation.schema.json",
  "title": "Zero-Knowledge Audit Attestation",
  "description": "A cryptographic attestation that a declared audit predicate or computation has been proven without exposing protected inputs. It does not independently establish causal derivation, legal liability, or royalty obligation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_id",
    "predicate",
    "proof_system",
    "public_inputs",
    "proof_ref",
    "verification_status",
    "scope_note",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "predicate_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "audit_context_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_system": {
      "type": "string",
      "minLength": 1
    },
    "public_inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "committed_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "proof_ref": {
      "type": "string",
      "minLength": 1
    },
    "verification_method_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifier_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "failed",
        "not_verified"
      ]
    },
    "scope_note": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

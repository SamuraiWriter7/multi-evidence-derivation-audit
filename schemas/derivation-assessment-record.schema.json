{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/meda/v0.4/derivation-assessment-record.schema.json",
  "title": "Derivation Assessment Record",
  "description": "A protocol-level assessment of evidentiary support for a possible derivation relationship within an audit case. Each assessment is immutable as a historical record and does not itself establish legal infringement, liability, or royalty obligation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_ref",
    "assessment_id",
    "origin_ref",
    "derivative_ref",
    "evidence_refs",
    "fusion_refs",
    "assessment_state",
    "assessment_basis",
    "protocol_version",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.4.0"
    },
    "case_ref": {
      "type": "string",
      "minLength": 1
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_ref": {
      "type": "string",
      "minLength": 1
    },
    "derivative_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fusion_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment_state": {
      "type": "string",
      "enum": [
        "insufficient",
        "suspected",
        "supported",
        "protocol_verified",
        "disputed"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "assessment_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflicting_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "assessment_policy_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "legal_effect": {
      "type": "string",
      "enum": [
        "none",
        "policy_dependent",
        "human_review_required",
        "externally_determined"
      ],
      "default": "none"
    },
    "protocol_version": {
      "type": "string",
      "const": "0.4.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assessment_state": {
            "const": "disputed"
          }
        },
        "required": [
          "assessment_state"
        ]
      },
      "then": {
        "properties": {
          "conflicting_evidence_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/meda/v0.5/audit-case-record.schema.json",
  "title": "Audit Case Record",
  "description": "A case-level envelope that groups the complete MEDA audit history, including evidence, relationships, fusion, assessments, attestations, challenges, reproductions, revisions, auditor opinions, reconciliation records, and external handoffs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "origin_ref",
    "derivative_ref",
    "case_state",
    "evidence_refs",
    "relationship_refs",
    "fusion_refs",
    "assessment_refs",
    "attestation_refs",
    "challenge_refs",
    "reproduction_refs",
    "revision_refs",
    "opinion_refs",
    "reconciliation_refs",
    "handoff_refs",
    "current_assessment_ref",
    "protocol_version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.5.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_ref": {
      "type": "string",
      "minLength": 1
    },
    "derivative_ref": {
      "type": "string",
      "minLength": 1
    },
    "case_state": {
      "type": "string",
      "enum": [
        "open",
        "collecting_evidence",
        "fusion_ready",
        "assessed",
        "under_challenge",
        "reproducing",
        "revision_pending",
        "disputed",
        "reconciling",
        "handoff_ready",
        "handed_off",
        "closed"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "relationship_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "fusion_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "assessment_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "attestation_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "challenge_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "reproduction_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "revision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "opinion_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "reconciliation_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "handoff_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "current_assessment_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "case_policy_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol_version": {
      "type": "string",
      "const": "0.5.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "case_state": {
            "enum": [
              "assessed",
              "revision_pending",
              "disputed",
              "reconciling",
              "handoff_ready",
              "handed_off",
              "closed"
            ]
          }
        },
        "required": [
          "case_state"
        ]
      },
      "then": {
        "properties": {
          "assessment_refs": {
            "minItems": 1
          },
          "current_assessment_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_state": {
            "enum": [
              "under_challenge",
              "disputed"
            ]
          }
        },
        "required": [
          "case_state"
        ]
      },
      "then": {
        "properties": {
          "challenge_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_state": {
            "const": "revision_pending"
          }
        },
        "required": [
          "case_state"
        ]
      },
      "then": {
        "properties": {
          "revision_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_state": {
            "enum": [
              "reconciling",
              "handoff_ready",
              "handed_off"
            ]
          }
        },
        "required": [
          "case_state"
        ]
      },
      "then": {
        "properties": {
          "opinion_refs": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_state": {
            "enum": [
              "handoff_ready",
              "handed_off"
            ]
          }
        },
        "required": [
          "case_state"
        ]
      },
      "then": {
        "properties": {
          "reconciliation_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "case_state": {
            "const": "handed_off"
          }
        },
        "required": [
          "case_state"
        ]
      },
      "then": {
        "properties": {
          "handoff_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

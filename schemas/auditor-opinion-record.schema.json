{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/meda/v0.5/auditor-opinion-record.schema.json",
  "title": "Auditor Opinion Record",
  "description": "A machine-readable non-binding opinion issued by an identified audit actor regarding a MEDA assessment. An auditor opinion is audit evidence about interpretation and does not itself constitute a legal, royalty, liability, or settlement verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_ref",
    "opinion_id",
    "auditor_ref",
    "auditor_type",
    "origin_ref",
    "derivative_ref",
    "assessment_ref",
    "position",
    "independence_status",
    "opinion_basis",
    "effect_scope",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.5.0"
    },
    "case_ref": {
      "type": "string",
      "minLength": 1
    },
    "opinion_id": {
      "type": "string",
      "minLength": 1
    },
    "auditor_ref": {
      "type": "string",
      "minLength": 1
    },
    "auditor_type": {
      "type": "string",
      "enum": [
        "human",
        "organization",
        "automated_system",
        "hybrid",
        "other"
      ]
    },
    "organization_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "credential_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "origin_ref": {
      "type": "string",
      "minLength": 1
    },
    "derivative_ref": {
      "type": "string",
      "minLength": 1
    },
    "assessment_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "fusion_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "challenge_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "reproduction_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "position": {
      "type": "string",
      "enum": [
        "supports",
        "partially_supports",
        "disputes",
        "insufficient_basis",
        "abstains"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "independence_status": {
      "type": "string",
      "enum": [
        "independent",
        "partially_independent",
        "not_independent",
        "unknown"
      ]
    },
    "dependency_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "opinion_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agreed_points": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "disputed_points": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "unresolved_points": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "effect_scope": {
      "type": "string",
      "const": "audit_only"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "independence_status": {
            "enum": [
              "partially_independent",
              "not_independent"
            ]
          }
        },
        "required": [
          "independence_status"
        ]
      },
      "then": {
        "properties": {
          "dependency_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "position": {
            "const": "disputes"
          }
        },
        "required": [
          "position"
        ]
      },
      "then": {
        "properties": {
          "disputed_points": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "position": {
            "const": "insufficient_basis"
          }
        },
        "required": [
          "position"
        ]
      },
      "then": {
        "properties": {
          "unresolved_points": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

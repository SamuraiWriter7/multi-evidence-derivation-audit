{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/meda/v0.5/audit-evidence-record.schema.json",
  "title": "Audit Evidence Record",
  "description": "A machine-readable record describing one item of evidence relevant to a possible derivation relationship within an audit case. An evidence record is not itself a derivation verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_ref",
    "evidence_id",
    "evidence_type",
    "origin_ref",
    "derivative_ref",
    "method",
    "maturity",
    "observation",
    "collected_at",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.5.0"
    },
    "case_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "watermark",
        "signed_receipt",
        "api_trace",
        "dataset_manifest",
        "training_attestation",
        "similarity",
        "white_box_lineage",
        "reproduction_output",
        "other"
      ]
    },
    "origin_ref": {
      "type": "string",
      "minLength": 1
    },
    "derivative_ref": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "type": "string",
      "enum": [
        "established",
        "emerging",
        "experimental"
      ]
    },
    "observation": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "statistic": {
      "type": [
        "number",
        "null"
      ]
    },
    "threshold": {
      "type": [
        "number",
        "null"
      ]
    },
    "calibration_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_event_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_artifact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "artifact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "collected_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha384",
            "sha512",
            "other"
          ]
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "challenge_status": {
      "type": "string",
      "enum": [
        "unchallenged",
        "challenged",
        "under_review",
        "invalidated"
      ],
      "default": "unchallenged"
    }
  }
}

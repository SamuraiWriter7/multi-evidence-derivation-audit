{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/meda/v0.5/audit-reconciliation-record.schema.json",
  "title": "Audit Reconciliation Record",
  "description": "A machine-readable non-binding reconciliation of multiple auditor opinions. It preserves agreement, disagreement, and unresolved questions without converting numerical majority into an automatic derivation, legal, royalty, or settlement verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_ref",
    "reconciliation_id",
    "origin_ref",
    "derivative_ref",
    "assessment_refs",
    "opinion_refs",
    "reconciliation_method",
    "majority_verdict_applied",
    "agreed_points",
    "disputed_points",
    "unresolved_points",
    "reconciliation_state",
    "basis",
    "effect_scope",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.5.0"
    },
    "case_ref": {
      "type": "string",
      "minLength": 1
    },
    "reconciliation_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_ref": {
      "type": "string",
      "minLength": 1
    },
    "derivative_ref": {
      "type": "string",
      "minLength": 1
    },
    "assessment_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "opinion_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "fusion_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "challenge_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "reproduction_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "reconciliation_method": {
      "type": "string",
      "enum": [
        "comparative_review",
        "independent_panel",
        "algorithmic_summary",
        "hybrid",
        "other"
      ]
    },
    "method_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "majority_verdict_applied": {
      "type": "boolean",
      "const": false
    },
    "agreed_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agreementPoint"
      },
      "default": []
    },
    "disputed_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disputePoint"
      },
      "default": []
    },
    "unresolved_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedPoint"
      },
      "default": []
    },
    "reconciliation_state": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "effect_scope": {
      "type": "string",
      "const": "audit_only"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "agreementPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "statement",
        "supporting_opinion_refs"
      ],
      "properties": {
        "point_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "supporting_opinion_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "assessment_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "disputePosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "opinion_refs"
      ],
      "properties": {
        "position": {
          "type": "string",
          "minLength": 1
        },
        "opinion_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "disputePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "statement",
        "positions"
      ],
      "properties": {
        "point_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/disputePosition"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "assessment_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "unresolvedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "statement",
        "opinion_refs",
        "unresolved_reason"
      ],
      "properties": {
        "point_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "opinion_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "assessment_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    }
  }
}

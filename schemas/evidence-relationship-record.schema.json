{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/meda/v0.2/evidence-relationship-record.schema.json",
  "title": "Evidence Relationship Record",
  "description": "A record describing dependency and evidentiary relationships among two or more evidence items.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relationship_id",
    "evidence_refs",
    "dependency_type",
    "evidentiary_effect",
    "basis",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "relationship_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependency_type": {
      "type": "string",
      "enum": [
        "independent",
        "partially_dependent",
        "same_source",
        "unknown"
      ]
    },
    "evidentiary_effect": {
      "type": "string",
      "enum": [
        "corroborating",
        "conflicting",
        "neutral",
        "unknown"
      ]
    },
    "dependency_source_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dependency_type": {
            "enum": [
              "partially_dependent",
              "same_source"
            ]
          }
        },
        "required": [
          "dependency_type"
        ]
      },
      "then": {
        "required": [
          "dependency_source_ref"
        ],
        "properties": {
          "dependency_source_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}

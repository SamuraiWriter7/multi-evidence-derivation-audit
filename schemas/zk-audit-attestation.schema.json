{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/meda/v0.5/zk-audit-attestation.schema.json",
  "title": "Zero-Knowledge Audit Attestation",
  "description": "A cryptographic attestation proving only a declared audit predicate or computation over protected inputs. It does not independently establish causal derivation, legal liability, royalty entitlement, allocation, or settlement obligation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_ref",
    "attestation_id",
    "origin_ref",
    "derivative_ref",
    "predicate",
    "audit_context_type",
    "audit_context_ref",
    "proof_system",
    "public_inputs",
    "proof_ref",
    "verification_status",
    "scope_note",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.5.0"
    },
    "case_ref": {
      "type": "string",
      "minLength": 1
    },
    "attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_ref": {
      "type": "string",
      "minLength": 1
    },
    "derivative_ref": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "predicate_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "audit_context_type": {
      "type": "string",
      "enum": [
        "evidence",
        "relationship",
        "fusion",
        "assessment",
        "case",
        "challenge",
        "reproduction",
        "revision",
        "opinion",
        "reconciliation",
        "handoff",
        "other"
      ]
    },
    "audit_context_ref": {
      "type": "string",
      "minLength": 1
    },
    "proof_system": {
      "type": "string",
      "minLength": 1
    },
    "public_inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "committed_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "proof_ref": {
      "type": "string",
      "minLength": 1
    },
    "verification_method_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifier_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "failed",
        "not_verified"
      ]
    },
    "scope_note": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

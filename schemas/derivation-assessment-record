{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/meda/v0.1/derivation-assessment-record.schema.json",
  "title": "Derivation Assessment Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "origin_ref",
    "derivative_ref",
    "evidence_refs",
    "assessment_state",
    "assessment_basis",
    "protocol_version",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "origin_ref": {
      "type": "string",
      "minLength": 1
    },
    "derivative_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment_state": {
      "type": "string",
      "enum": [
        "insufficient",
        "suspected",
        "supported",
        "protocol_verified",
        "disputed"
      ]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "assessment_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "conflicting_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "default": []
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "legal_effect": {
      "type": "string",
      "enum": [
        "none",
        "policy_dependent",
        "human_review_required",
        "externally_determined"
      ],
      "default": "none"
    },
    "protocol_version": {
      "const": "0.1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
